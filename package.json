{
  "name": "hermes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 28085",
    "build": "next build",
    "start": "next start -p ${PORT:-28085}",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "buzzheavier:smoke": "node --env-file=.env.local --import tsx scripts/buzzheavier-smoke.ts",
    "wipe": "node --env-file=.env.local --import tsx scripts/wipe.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "jose": "^6.2.3",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.8",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
