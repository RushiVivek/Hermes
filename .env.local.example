# hermes environment variables (copy to .env.local; never commit .env.local)

# Shared family vault password (plain string; checked with timing-safe SHA-256 compare)
HERMES_PASSWORD=changeme

# 32+ char random string used to sign session cookies
# generate: openssl rand -base64 48
SESSION_SECRET=changeme_to_a_long_random_string_at_least_32_chars

# Firebase Admin service-account credentials.
# Get the JSON: Firebase Console → Project Settings → Service accounts → Generate new private key.
#
# RECOMMENDED — base64. No quoting/escaping foot-guns; works identically on
#   .env.local, Vercel, and CI. From the project root:
#       base64 -i ~/Downloads/your-service-account.json | pbcopy
#   then paste below (no quotes needed).
#
# FIREBASE_SERVICE_ACCOUNT=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiw...
#
# Alternative — inline JSON. Single-quote it so dotenv keeps it whole:
#   FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}'

FIREBASE_SERVICE_ACCOUNT=

# Buzzheavier accounts (used by /upload and delete).
# JSON array of { id, rootDir }:
#   - `id`     = Buzzheavier Account ID (also used as the Bearer token).
#   - `rootDir` = directory ID under the account root where uploads land.
# Single-quote the value so dotenv keeps it whole. With one account:
BUZZHEAVIER_ACCOUNTS='[{"id":"YOUR_ACCOUNT_ID","rootDir":"YOUR_ROOT_DIR_ID"}]'
# Index of the account that *new* uploads go to. Old files keep working from
# whichever account uploaded them. Bump this when an account fills (~500MB).
BUZZHEAVIER_ACTIVE_INDEX=0

# --- not used yet (Gemini comes in v2) ---
# GEMINI_API_KEY=
