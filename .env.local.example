# hermes environment variables (copy to .env.local; never commit .env.local)

# Shared family vault password, stored only as an scrypt hash.
# Generate:  npm run hash-password   (prompts twice, prints the line below)
# Changing it signs every device out.
HERMES_PASSWORD_HASH=

# 32+ char random string used to sign session cookies
# generate: openssl rand -base64 48
SESSION_SECRET=changeme_to_a_long_random_string_at_least_32_chars

# Firebase Admin service-account credentials.
# Get the JSON: Firebase Console → Project Settings → Service accounts → Generate new private key.
#
# RECOMMENDED — base64. No quoting/escaping foot-guns; works identically on
#   .env.local, Render, and CI:
#       base64 -w0 your-service-account.json
#   then paste below (no quotes needed).
#
# FIREBASE_SERVICE_ACCOUNT=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiw...
#
# Alternative — inline JSON. Single-quote it so dotenv keeps it whole:
#   FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}'

FIREBASE_SERVICE_ACCOUNT=

# Cloudflare R2 (file storage). Dashboard → R2 → create a private bucket, then
# R2 → Manage API tokens → create a token with "Object Read & Write" scoped to
# that bucket only. The account id is shown on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hermes

# Gemini API key — powers "Auto-organize with AI" on the upload screen and
# smarter chat search. Get one at https://aistudio.google.com/apikey.
# Optional: if unset, upload uses manual filing and chat uses keyword search.
# GEMINI_API_KEY=
